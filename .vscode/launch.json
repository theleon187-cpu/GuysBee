{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GuysBee (https/http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/GuysBee/bin/Debug/net10.0/GuysBee.dll",
      "args": [],
      "cwd": "${workspaceFolder}/GuysBee",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7080;http://localhost:5080"
      }
    }
  ]
}
