{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/GuysBee/GuysBee.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "libman-restore",
      "command": "libman",
      "type": "process",
      "args": [
        "restore"
      ],
      "options": {
        "cwd": "${workspaceFolder}/GuysBee"
      },
      "problemMatcher": []
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/GuysBee/GuysBee.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
