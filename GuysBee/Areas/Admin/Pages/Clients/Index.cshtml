@page
@model GuysBee.Areas.Admin.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Comptes clients";
}
<h1 class="h3 mb-1">Comptes clients</h1>
<p class="gb-admin-help">Voyez ici les clients inscrits sur le site, ouvrez ou fermez les inscriptions, bloquez ou supprimez un compte.</p>

<div class="gb-admin-card">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <strong>Inscriptions :</strong>
            @if (Model.AccountsEnabled)
            {
                <span class="badge text-bg-success">Ouvertes</span>
                <div class="gb-admin-help mb-0">Les clients peuvent créer un compte depuis le site.</div>
            }
            else
            {
                <span class="badge text-bg-secondary">Fermées</span>
                <div class="gb-admin-help mb-0">Les clients commandent sans compte.</div>
            }
            @if (!Model.ShopEnabled)
            {
                <div class="gb-admin-help mb-0">La commande en ligne est désactivée : les comptes restent invisibles tant qu'elle n'est pas activée dans <a asp-area="Admin" asp-page="/Boutique/Index">Boutique en ligne</a>.</div>
            }
        </div>
        <a class="btn btn-outline-dark" asp-area="Admin" asp-page="/Clients/Inscriptions">Gérer les inscriptions</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <label for="q" class="form-label">Rechercher un client</label>
        <input id="q" name="q" class="form-control" value="@Model.Q" placeholder="Nom ou e-mail" />
    </div>
    <div class="col-md-4 d-flex align-items-end"><button type="submit" class="btn btn-outline-dark w-100">Rechercher</button></div>
</form>

@if (Model.Clients.Count == 0)
{
    <p>Aucun compte client pour le moment.</p>
}
else
{
    <p class="gb-admin-help">@Model.Clients.Count compte(s).</p>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Client</th><th>E-mail</th><th>Téléphone</th><th>Ville</th><th>État</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Clients)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td>@c.City</td>
                        <td>@if (c.Blocked) { <span class="badge text-bg-danger">Bloqué</span> } else { <span class="badge text-bg-success">Actif</span> }</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <form method="post" asp-page-handler="Block">
                                    <input type="hidden" name="id" value="@c.UserId" />
                                    <input type="hidden" name="block" value="@((!c.Blocked).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@(c.Blocked ? "Réactiver" : "Bloquer")</button>
                                </form>
                                data-gb-confirm="Supprimer définitivement ce compte ?"
                                    <input type="hidden" name="id" value="@c.UserId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
