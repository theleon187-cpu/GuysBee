@page
@model GuysBee.Areas.Admin.Pages.Historique.IndexModel
@using GuysBee.Services
@{
    ViewData["Title"] = "Historique";
    var fr = new System.Globalization.CultureInfo("fr-FR");
    string Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.Local).ToString("dd/MM/yyyy HH:mm", fr);
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-historique.css" asp-append-version="true" />
}
<h1 class="h3 mb-3">Historique</h1>

<nav class="gb-hist-tabs" aria-label="Sections de l'historique">
    <a class="gb-hist-tab @(Model.ShowJournal ? "" : "gb-active")" asp-route-Tab="evolutions">Évolutions du site</a>
    <a class="gb-hist-tab @(Model.ShowJournal ? "gb-active" : "")" asp-route-Tab="journal">Journal des modifications</a>
</nav>

@if (!Model.ShowJournal)
{
    <form method="get" class="gb-hist-filter">
        <input type="hidden" name="Tab" value="evolutions" />
        <div>
            <label class="form-label" for="f-cat">Domaine</label>
            <select id="f-cat" name="Category" class="form-select">
                <option value="">Tous les domaines</option>
                @foreach (var c in ChangeLog.Categories)
                {
                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-secondary">Filtrer</button>
        <span class="gb-admin-help">@Model.Releases.Count version(s) · @Model.ItemCount évolution(s)</span>
    </form>

    <ol class="gb-timeline">
        @foreach (var r in Model.Releases)
        {
            <li class="gb-timeline-item">
                <article class="gb-timeline-card">
                    <span class="gb-timeline-date">@r.Date.ToString("dd MMMM yyyy", fr)</span>
                    <h2 class="gb-timeline-title">@r.Title</h2>
                    <p class="gb-timeline-summary">@r.Summary</p>
                    <ul class="gb-timeline-list">
                        @foreach (var i in r.Items)
                        {
                            <li><span class="gb-tag @IndexModel.TagClass(i.Category)">@i.Category</span><span>@i.Text</span></li>
                        }
                    </ul>
                </article>
            </li>
        }
    </ol>
}
else
{
    <div class="gb-hist-stats">
        <div class="gb-hist-stat"><strong>@Model.WeekCreated</strong><span>création(s) cette semaine</span></div>
        <div class="gb-hist-stat"><strong>@Model.WeekModified</strong><span>modification(s) cette semaine</span></div>
        <div class="gb-hist-stat"><strong>@Model.WeekDeleted</strong><span>suppression(s) cette semaine</span></div>
        <div class="gb-hist-stat"><strong>@Model.TotalCount</strong><span>ligne(s) au journal</span></div>
    </div>

    <section class="gb-admin-card" aria-labelledby="h-journal">
        <h2 id="h-journal" class="h5">Qui a modifié quoi</h2>
        <form method="get" class="gb-hist-filter">
            <input type="hidden" name="Tab" value="journal" />
            <div>
                <label class="form-label" for="f-action">Type d'action</label>
                <select id="f-action" name="Action" class="form-select">
                    <option value="">Toutes</option>
                    @foreach (var a in IndexModel.Actions)
                    {
                        <option value="@a" selected="@(Model.Action == a)">@a</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="f-entity">Élément</label>
                <select id="f-entity" name="Entity" class="form-select">
                    <option value="">Tous</option>
                    @foreach (var n in Model.Entities)
                    {
                        <option value="@n" selected="@(Model.Entity == n)">@n</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-outline-secondary">Filtrer</button>
        </form>

        @if (Model.Entries.Count == 0)
        {
            <p class="gb-hist-empty mb-0">Aucune modification enregistrée pour le moment. Elles apparaîtront ici dès qu'un élément sera modifié en administration.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle gb-hist-table">
                    <thead>
                        <tr><th>Date</th><th>Auteur</th><th>Action</th><th>Élément</th><th>Détail</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td>@Local(e.CreatedUtc)</td>
                                <td>@e.UserName</td>
                                <td><span class="gb-hist-action @IndexModel.ActionClass(e.Action)">@e.Action</span></td>
                                <td>@e.EntityName@(e.EntityId is null ? "" : " n°" + e.EntityId)</td>
                                <td class="gb-hist-details">@e.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="gb-hist-pager" aria-label="Pagination">
                <span class="gb-admin-help">Page @Model.PageNumber / @Model.TotalPages</span>
                <span>
                    @if (Model.PageNumber > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-route-Tab="journal" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-Action="@Model.Action" asp-route-Entity="@Model.Entity">Précédent</a>
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-route-Tab="journal" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-Action="@Model.Action" asp-route-Entity="@Model.Entity">Suivant</a>
                    }
                </span>
            </nav>
        }

        <form method="post" asp-page-handler="Purge" class="mt-3">
            <button type="submit" class="btn btn-sm btn-outline-danger">Nettoyer les lignes de plus d'un an</button>
        </form>
    </section>
}
