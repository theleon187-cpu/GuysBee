@{
    var path = Context.Request.Path.Value ?? "";
    string Active(string prefix) =>
        prefix == "/Admin" ? (path.TrimEnd('/').Equals("/Admin", StringComparison.OrdinalIgnoreCase) ? "gb-active" : "")
                           : (path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "gb-active" : "");
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - Administration GUY's Bee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="gb-admin @(signedIn ? "gb-admin-shell" : "gb-admin-bare")">
@if (signedIn)
{
    <aside class="gb-sidebar">
        <div class="gb-sidebar-top">
            <a class="gb-sidebar-brand" href="/Admin"><span class="gb-sidebar-logo" aria-hidden="true">&#x2B21;</span> GUY's Bee</a>
            <button class="gb-sidebar-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu" aria-controls="adminMenu" aria-expanded="false" aria-label="Menu">&#9776;</button>
        </div>
        <div class="collapse gb-sidebar-collapse" id="adminMenu">
            <nav class="gb-sidebar-nav" aria-label="Administration">
                <p class="gb-sidebar-label">Pilotage</p>
                <a class="gb-sidebar-link @Active("/Admin")" href="/Admin">Tableau de bord</a>
                <a class="gb-sidebar-link @Active("/Admin/Messages")" href="/Admin/Messages">Messages</a>
                <p class="gb-sidebar-label">Contenu</p>
                <a class="gb-sidebar-link @Active("/Admin/Photos")" href="/Admin/Photos">Photos</a>
                <a class="gb-sidebar-link @Active("/Admin/Textes")" href="/Admin/Textes">Textes du site</a>
                <a class="gb-sidebar-link @Active("/Admin/Accueil")" href="/Admin/Accueil">Page d'accueil</a>
                <a class="gb-sidebar-link @Active("/Admin/Navigation")" href="/Admin/Navigation">Menu du site</a>
                <a class="gb-sidebar-link @Active("/Admin/Calendrier")" href="/Admin/Calendrier">Calendrier de la ruche</a>
                <p class="gb-sidebar-label">Boutique</p>
                <a class="gb-sidebar-link @Active("/Admin/Miels")" href="/Admin/Miels">Gammes et produits</a>
                <p class="gb-sidebar-label">Site</p>
                <a class="gb-sidebar-link @Active("/Admin/Reglages")" href="/Admin/Reglages">R&eacute;glages</a>
                <a class="gb-sidebar-link" href="/" target="_blank" rel="noopener">Voir le site &#8599;</a>
            </nav>
            <form method="post" asp-area="Admin" asp-page="/Logout" class="gb-sidebar-logout">
                <button type="submit" class="btn btn-sm btn-outline-light w-100">Se d&eacute;connecter</button>
            </form>
        </div>
    </aside>
}

    <main class="gb-admin-main">
        <div class="gb-admin-content">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success gb-admin-alert" role="status">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger gb-admin-alert" role="alert">@error</div>
            }
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
