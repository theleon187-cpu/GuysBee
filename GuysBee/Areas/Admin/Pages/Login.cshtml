@page
@model GuysBee.Areas.Admin.Pages.LoginModel
@{
    ViewData["Title"] = "Connexion";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="gb-admin-card">
            <h1 class="h4 mb-3">Connexion</h1>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Adresse e-mail</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Mot de passe</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-warning w-100">Se connecter</button>
            </form>
        </div>
    </div>
</div>
