@page
@model GuysBee.Areas.Admin.Pages.Textes.EditModel
@{
    ViewData["Title"] = "Modifier une page";
}
<h1 class="h3 mb-3">Modifier : @Model.Input.Title</h1>
<form method="post" class="gb-admin-card">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label">Titre</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.MetaDescription" class="form-label">Résumé pour Google (une ou deux phrases)</label>
        <input asp-for="Input.MetaDescription" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.BodyHtml" class="form-label">Contenu</label>
        <textarea asp-for="Input.BodyHtml" class="form-control gb-richtext" rows="14"></textarea>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.IsPublished" class="form-check-input" />
        <label asp-for="Input.IsPublished" class="form-check-label">Page publiée</label>
    </div>
    <button type="submit" class="btn btn-warning">Enregistrer</button>
    <a class="btn btn-outline-dark" asp-page="Index">Annuler</a>
    <a class="btn btn-link" href="/p/@Model.Slug" target="_blank" rel="noopener">Voir la page</a>
</form>

@section Scripts {
    <partial name="_RichTextEditor" />
}
