@page
@model GuysBee.Areas.Admin.Pages.Textes.LogoModel
@{
    ViewData["Title"] = "Logo et texte";
}
<h1 class="h3 mb-3">Logo et texte</h1>
<form method="post" enctype="multipart/form-data" class="gb-admin-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" for="LogoFile">Logo (image)</label>
        <div class="mb-2">
            <img src="@(string.IsNullOrEmpty(Model.LogoBaseName) ? "/img/logo.jpg" : GuysBee.Services.MediaUrls.Src(Model.LogoBaseName, 480))" alt="Logo actuel" width="72" height="72" />
        </div>
        <input type="file" accept="image/jpeg,image/png,image/webp" id="LogoFile" name="LogoFile" data-crop-ratio="1" class="form-control" />
        <div class="gb-admin-help">Image carrée de préférence (JPG, PNG ou WebP). Elle remplace le logo actuel en haut du site.</div>
        @if (!string.IsNullOrEmpty(Model.LogoBaseName))
        {
            <div class="form-check mt-2">
                <input type="checkbox" class="form-check-input" id="RemoveLogo" name="RemoveLogo" value="true" />
                <label class="form-check-label" for="RemoveLogo">Revenir au logo d'origine</label>
            </div>
        }
    </div>
    <div class="mb-3">
        <label class="form-label" for="BrandHtml">Texte</label>
        <textarea id="BrandHtml" name="BrandHtml" class="form-control gb-richtext" data-font="brand" rows="4">@Model.BrandHtml</textarea>
        <div class="gb-admin-help">Nom affiché en haut du site, à côté du logo. Laissez vide pour afficher « GUY's Bee ».</div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="BrandFont">Police</label>
        <select id="BrandFont" name="BrandFont" class="form-select">
            @foreach (var f in Model.Fonts)
            {
                <option value="@f.Id" selected="@(f.Id == (Model.BrandFont ?? ""))">@f.Label</option>
            }
        </select>
        <div class="gb-admin-help">Pour utiliser votre propre police, importez-la d'abord dans « Textes du site ».</div>
    </div>
    <button type="submit" class="btn btn-warning">Enregistrer</button>
    <a class="btn btn-outline-dark" asp-page="Index">Annuler</a>
</form>

@section Scripts {
    <partial name="_RichTextEditor" />
}
