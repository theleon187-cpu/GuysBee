@page
@model GuysBee.Pages.OuNousTrouverModel
@{
    ViewData["Title"] = "Où nous trouver";
    ViewData["Description"] = "Points de vente et retrait des miels GUY's Bee.";
    var fr = new System.Globalization.CultureInfo("fr-FR");
}
<h1 class="gb-page-title">Où nous trouver</h1>
<section class="gb-section">
    <div class="gb-container">
        @if (Model.MapPoints.Count > 0)
        {
            <section class="gb-points-map-wrap" aria-label="Carte des points de vente">
                <div id="gb-points-map" class="gb-points-map" role="region" aria-label="Carte interactive : cliquez sur un repère pour voir les détails"></div>
                <ul class="gb-map-legend">
                    <li><span class="gb-map-dot gb-map-dot-marche" aria-hidden="true"></span> Marchés</li>
                    <li><span class="gb-map-dot gb-map-dot-commerce" aria-hidden="true"></span> Commerces</li>
                </ul>
                <script type="application/json" id="gb-points-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapPoints, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web) { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))</script>
            </section>
        }
        <section aria-labelledby="gb-agenda-title">
            <h2 class="gb-find-subtitle gb-find-list-title" id="gb-agenda-title">Sur les marchés</h2>
            <div class="gb-card gb-agenda">
                @if (Model.Events.Count == 0)
                {
                    <p class="gb-card-text">Aucun rendez-vous programmé pour le moment.</p>
                }
                else
                {
                    <ul class="gb-agenda-list">
                        @foreach (var e in Model.Events)
                        {
                            <li class="gb-agenda-item">
                                <span class="gb-agenda-date">@GuysBee.Services.WeekDays.Format(e.DaysMask)</span>
                                <div class="gb-agenda-body">
                                    @if (!string.IsNullOrEmpty(e.PhotoBaseName)) { <img class="gb-agenda-photo" src="@GuysBee.Services.MediaUrls.Src(e.PhotoBaseName, 480)" srcset="@GuysBee.Services.MediaUrls.SrcSet(e.PhotoBaseName)" sizes="(min-width: 900px) 20vw, 50vw" alt="@e.Title" loading="lazy" /> }
                                    <strong>@e.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(e.Hours)) { <span class="gb-agenda-hours">@e.Hours</span> }
                                    @if (!string.IsNullOrWhiteSpace(e.Place)) { <span class="gb-agenda-place">@e.Place</span> }
                                    @if (!string.IsNullOrWhiteSpace(e.MapUrl))
                                    {
                                        <a class="gb-agenda-map" href="@e.MapUrl" target="_blank" rel="noopener">Itinéraire sur Google Maps</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.Details)) { <span class="gb-agenda-details">@e.Details</span> }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        @if (Model.SalePoints.Count > 0)
        {
            <h2 class="gb-find-subtitle gb-find-list-title">Dans les commerces</h2>
            <div class="gb-grid">
                @foreach (var sp in Model.SalePoints)
                {
                    <article class="gb-card">
                        @if (!string.IsNullOrEmpty(sp.PhotoBaseName)) { <img class="gb-find-photo" src="@GuysBee.Services.MediaUrls.Src(sp.PhotoBaseName, 480)" srcset="@GuysBee.Services.MediaUrls.SrcSet(sp.PhotoBaseName)" sizes="(min-width: 900px) 33vw, 100vw" alt="@sp.Name" loading="lazy" /> }
                        <h3 class="gb-card-title">@sp.Name</h3>
                        <p>@sp.Address<br />@sp.PostalCode @sp.City</p>
                        @if (!string.IsNullOrWhiteSpace(sp.Schedule)) { <p>@sp.Schedule</p> }
                        @if (!string.IsNullOrWhiteSpace(sp.Details)) { <p class="gb-agenda-details">@sp.Details</p> }
                        @if (!string.IsNullOrWhiteSpace(sp.Phone)) { <p><a href="tel:@sp.Phone.Replace(" ", "")">@sp.Phone</a></p> }
                        @if (!string.IsNullOrWhiteSpace(sp.MapUrl))
                        {
                            <p><a href="@sp.MapUrl" target="_blank" rel="noopener">Itinéraire sur Google Maps</a></p>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    @if (Model.MapPoints.Count > 0)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@("@")1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <script src="https://unpkg.com/leaflet@("@")1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script src="~/js/points-map.js" asp-append-version="true"></script>
    }
}
