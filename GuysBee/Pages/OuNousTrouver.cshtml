@page
@model GuysBee.Pages.OuNousTrouverModel
@{
    ViewData["Title"] = "Où nous trouver";
    ViewData["Description"] = "Points de vente et retrait des miels GUY's Bee.";
    var fr = new System.Globalization.CultureInfo("fr-FR");
    var sectionsClass = "gb-find-sections gb-find-" + Model.Layout + (Model.MarketsFirst ? " gb-find-markets-first" : " gb-find-shops-first");
}
<h1 class="gb-page-title">Où nous trouver</h1>
<section class="gb-section">
    <div class="gb-container">
        <div class="gb-find-layout gb-find-map-@Model.MapPosition">
        @if (Model.ShowMap && Model.MapPoints.Count > 0)
        {
            <section class="gb-points-map-wrap" aria-label="Carte des points de vente">
                <div id="gb-points-map" class="gb-points-map" role="region" aria-label="Carte interactive : cliquez sur un repère pour voir les détails"></div>
                <ul class="gb-map-legend">
                    <li><span class="gb-map-dot gb-map-dot-marche" aria-hidden="true"></span> Marchés</li>
                    <li><span class="gb-map-dot gb-map-dot-commerce" aria-hidden="true"></span> Commerces</li>
                </ul>
                <script type="application/json" id="gb-points-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapPoints, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web) { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))</script>
            </section>
        }
        @if (Model.ShowFilter)
        {
        <div class="gb-quick-filter" role="search">
            <label for="gb-quick-filter-input" class="gb-quick-filter-label">Filtre rapide</label>
            <input id="gb-quick-filter-input" class="gb-quick-filter-input" type="search" placeholder="Ville, nom, jour… (ex. Samedi, Tarare)" autocomplete="off" />
            <div class="gb-quick-filter-types" role="group" aria-label="Type de point">
                <label class="gb-quick-filter-type"><input type="checkbox" id="gb-filter-marche" checked /><span class="gb-quick-filter-chip gb-quick-filter-chip-marche">Marchés</span></label>
                <label class="gb-quick-filter-type"><input type="checkbox" id="gb-filter-commerce" checked /><span class="gb-quick-filter-chip gb-quick-filter-chip-commerce">Commerces</span></label>
            </div>
            <p class="gb-quick-filter-empty" id="gb-quick-filter-empty" hidden aria-live="polite">Aucun résultat pour cette recherche.</p>
        </div>
        }
        <div class="@sectionsClass">
        <section aria-labelledby="gb-agenda-title" data-gb-group="marche">
            <h2 class="gb-find-subtitle gb-find-list-title" id="gb-agenda-title">@Model.MarketsTitle</h2>
            <div class="gb-card gb-agenda">
                @if (Model.Events.Count == 0)
                {
                    <p class="gb-card-text">Aucun rendez-vous programmé pour le moment.</p>
                }
                else
                {
                    <ul class="gb-agenda-list">
                        @foreach (var e in Model.Events)
                        {
                            <li class="gb-agenda-item">
                                <span class="gb-agenda-date">@GuysBee.Services.WeekDays.Format(e.DaysMask)</span>
                                <div class="gb-agenda-body@(string.IsNullOrEmpty(e.PhotoBaseName) ? "" : " gb-agenda-body-photo")">
                                    @if (Model.ShowPhotos && !string.IsNullOrEmpty(e.PhotoBaseName)) { <img class="gb-agenda-photo" src="@GuysBee.Services.MediaUrls.Src(e.PhotoBaseName, 480)" srcset="@GuysBee.Services.MediaUrls.SrcSet(e.PhotoBaseName)" sizes="(min-width: 900px) 20vw, 50vw" alt="@e.Title" loading="lazy" /> }
                                    <strong>@e.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(e.Hours)) { <span class="gb-agenda-hours">@e.Hours</span> }
                                    @if (!string.IsNullOrWhiteSpace(e.Place)) { <span class="gb-agenda-place">@e.Place</span> }
                                    @if (!string.IsNullOrWhiteSpace(e.MapUrl))
                                    {
                                        <a class="gb-agenda-map" href="@e.MapUrl" target="_blank" rel="noopener">Itinéraire sur Google Maps</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.Details)) { <span class="gb-agenda-details">@e.Details</span> }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        @if (Model.SalePoints.Count > 0)
        {
            <section data-gb-group="commerce">
            <h2 class="gb-find-subtitle gb-find-list-title">@Model.ShopsTitle</h2>
            <div class="gb-card gb-agenda">
                <ul class="gb-agenda-list">
                    @foreach (var sp in Model.SalePoints)
                    {
                        <li class="gb-agenda-item">
                            <span class="gb-agenda-date">@sp.City</span>
                            <div class="gb-agenda-body@(string.IsNullOrEmpty(sp.PhotoBaseName) ? "" : " gb-agenda-body-photo")">
                                @if (Model.ShowPhotos && !string.IsNullOrEmpty(sp.PhotoBaseName)) { <img class="gb-agenda-photo" src="@GuysBee.Services.MediaUrls.Src(sp.PhotoBaseName, 480)" srcset="@GuysBee.Services.MediaUrls.SrcSet(sp.PhotoBaseName)" sizes="(min-width: 900px) 20vw, 50vw" alt="@sp.Name" loading="lazy" /> }
                                <strong>@sp.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(sp.Schedule)) { <span class="gb-agenda-hours">@sp.Schedule</span> }
                                <span class="gb-agenda-place">@sp.Address, @sp.PostalCode @sp.City</span>
                                @if (!string.IsNullOrWhiteSpace(sp.Phone)) { <a class="gb-agenda-map" href="tel:@sp.Phone.Replace(" ", "")">@sp.Phone</a> }
                                @if (!string.IsNullOrWhiteSpace(sp.MapUrl))
                                {
                                    <a class="gb-agenda-map" href="@sp.MapUrl" target="_blank" rel="noopener">Itinéraire sur Google Maps</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(sp.Details)) { <span class="gb-agenda-details">@sp.Details</span> }
                            </div>
                        </li>
                    }
                </ul>
            </div>
            </section>
        }
        </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (Model.ShowFilter) { <script src="~/js/quick-filter.js" asp-append-version="true"></script> }
    @if (Model.ShowMap && Model.MapPoints.Count > 0)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@("@")1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <script src="https://unpkg.com/leaflet@("@")1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script src="~/js/points-map.js" asp-append-version="true"></script>
    }
}
