@page
@model GuysBee.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Contactez GUY's Bee pour une question ou une commande.";
}
<h1 class="gb-page-title">Contact</h1>
<section class="gb-section">
    <div class="gb-container">
        @if (Model.Sent)
        {
            <p class="gb-alert" role="status">Merci, votre message a bien été envoyé. Nous vous répondrons rapidement.</p>
        }
        else
        {
            <form method="post" class="gb-form">
                <div class="gb-hp" aria-hidden="true">
                    <label for="Website">Ne pas remplir</label>
                    <input id="Website" name="Website" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <div class="gb-field">
                    <label asp-for="Input.Name">Votre nom</label>
                    <input asp-for="Input.Name" autocomplete="name" />
                    <span class="gb-field-error" asp-validation-for="Input.Name"></span>
                </div>
                <div class="gb-field">
                    <label asp-for="Input.Email">Votre e-mail</label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" />
                    <span class="gb-field-error" asp-validation-for="Input.Email"></span>
                </div>
                <div class="gb-field">
                    <label asp-for="Input.Subject">Sujet</label>
                    <input asp-for="Input.Subject" />
                    <span class="gb-field-error" asp-validation-for="Input.Subject"></span>
                </div>
                <div class="gb-field">
                    <label asp-for="Input.Body">Votre message</label>
                    <textarea asp-for="Input.Body" rows="6"></textarea>
                    <span class="gb-field-error" asp-validation-for="Input.Body"></span>
                </div>
                <button type="submit" class="gb-btn">Envoyer</button>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
