@page
@using GuysBee.Services
@using GuysBee.Data.Entities
@model GuysBee.Pages.Produits.IndexModel
@{
    var title = Model.Current?.Name ?? "Boutique";
    ViewData["Title"] = title;
    ViewData["Description"] = Model.Current?.Description ?? "Les produits de GUY's Bee, récoltés et préparés à Saint-Julien-sur-Bibost.";
    var grouped = Model.Current is null && Model.Categories.Count > 1;
}
<h1 class="gb-page-title">@title</h1>
<section class="gb-section">
    <div class="gb-container">
        @if (Model.Current?.Description is { Length: > 0 } intro)
        {
            <p class="gb-category-intro">@intro</p>
        }
        @if (Model.Categories.Count > 1)
        {
            <nav class="gb-category-nav" aria-label="Gammes de produits">
                <a href="/Produits" aria-current="@(Model.Current is null ? "true" : "false")">Toute la boutique</a>
                @foreach (var c in Model.Categories)
                {
                    <a href="/Produits?gamme=@c.Slug" aria-current="@(Model.Current?.Id == c.Id ? "true" : "false")">@c.Name</a>
                }
            </nav>
        }

        @if (grouped)
        {
            foreach (var c in Model.Categories)
            {
                <h2 class="gb-section-title"><a href="/Produits?gamme=@c.Slug">@c.Name</a></h2>
                <div class="gb-grid">
                    @foreach (var p in Model.Products.Where(x => x.CategoryId == c.Id))
                    {
                        <partial name="_ProductCard" model="p" />
                    }
                </div>
            }
            var others = Model.Products.Where(x => x.CategoryId == null).ToList();
            if (others.Count > 0)
            {
                <h2 class="gb-section-title">Autres produits</h2>
                <div class="gb-grid">
                    @foreach (var p in others)
                    {
                        <partial name="_ProductCard" model="p" />
                    }
                </div>
            }
        }
        else
        {
            <div class="gb-grid">
                @foreach (var p in Model.Products)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        }
    </div>
</section>
