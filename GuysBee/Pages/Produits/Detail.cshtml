@page "/Produits/{slug}"
@using GuysBee.Services
@model GuysBee.Pages.Produits.DetailModel
@{
    ViewData["Title"] = Model.Product.Name;
    ViewData["Description"] = Model.Product.ShortDescription;
}
<article class="gb-section">
    <div class="gb-container gb-prose">
        <h1>@Model.Product.Name</h1>
        <p class="gb-lead">@Model.Product.ShortDescription</p>

        @if (Model.Product.MainMedia is { } img)
        {
            <img src="@MediaUrls.Src(img, 800)" srcset="@MediaUrls.SrcSet(img)" sizes="(min-width: 800px) 70ch, 100vw" alt="@MediaUrls.Alt(img)" width="800" height="800" />
        }

        @if (!string.IsNullOrWhiteSpace(Model.Product.LongDescription))
        {
            <p>@Model.Product.LongDescription</p>
        }

        <h2>Conditionnements</h2>
        <ul class="gb-variants">
            @foreach (var v in Model.Product.Variants.Where(v => v.IsActive))
            {
                <li>
                    <span>@v.Label</span>
                    <span>
                        <span class="gb-price">@v.Price.ToString("0.00") €</span>
                        @if (v.Stock <= 0)
                        {
                            <span class="gb-tag gb-tag-out">Momentanément indisponible</span>
                        }
                    </span>
                </li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(Model.Product.UsageTips))
        {
            <h2>Conseils</h2>
            <p>@Model.Product.UsageTips</p>
        }

        <p><a href="/Produits">&larr; Tous nos miels</a></p>
    </div>
</article>
