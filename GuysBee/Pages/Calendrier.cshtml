@page
@model GuysBee.Pages.CalendrierModel
@{
    ViewData["Title"] = "La ruche au fil des saisons";
    ViewData["Description"] = "Ce que font les abeilles et l'apiculteur, mois après mois.";
    var current = DateTime.Now.Month;
}
<h1 class="gb-page-title">La ruche au fil des saisons</h1>
<section class="gb-section">
    <div class="gb-container">
        <p class="gb-lead">Suivez la vie de la ruche tout au long de l'année.</p>
        <div class="gb-calendar">
            @foreach (var e in Model.Entries)
            {
                <article class="gb-calendar-item @(e.Month == current ? "gb-calendar-item-current" : "")">
                    @if (e.Media is { } photo)
                    {
                        <img class="gb-calendar-photo" src="@GuysBee.Services.MediaUrls.Src(photo, 800)" srcset="@GuysBee.Services.MediaUrls.SrcSet(photo)" sizes="(min-width: 900px) 33vw, 100vw" alt="@(string.IsNullOrWhiteSpace(photo.AltText) ? e.Title : photo.AltText)" loading="lazy" />
                    }
                    <h2>@e.Title</h2>
                    <p><strong>Les abeilles :</strong></p>
                    <div>@GuysBee.Services.RichText.Render(e.WhatBeesDo)</div>
                    <p><strong>L'apiculteur :</strong></p>
                    <div>@GuysBee.Services.RichText.Render(e.WhatBeekeeperDoes)</div>
                </article>
            }
        </div>
    </div>
</section>
