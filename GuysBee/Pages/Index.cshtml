@page
@using GuysBee.Services
@model IndexModel
@{
    ViewData["Title"] = "Apiculteur à Saint-Julien-sur-Bibost";
}

@foreach (var block in Model.Sections)
{
    switch (block.Kind)
    {
        case "Hero":
            <section class="gb-hero" aria-label="Photos de l'exploitation">
                @for (var i = 0; i < Model.HeroMedias.Count; i++)
                {
                    var hero = Model.HeroMedias[i];
                    <img class="gb-hero-media@(i == 0 ? " gb-hero-active" : "")" src="@MediaUrls.Src(hero, 1200)" srcset="@MediaUrls.SrcSet(hero)" sizes="100vw" alt="" loading="@(i == 0 ? "eager" : "lazy")" />
                }
                </section>
                <section class="gb-hero-intro" aria-labelledby="hero-title">
                    <div class="gb-container gb-hero-inner">
                        <h1 id="hero-title" class="gb-hero-title">@block.Title</h1>
                    <p class="gb-hero-text">@block.Subtitle</p>
                    <div class="gb-hero-actions">
                    @if (!string.IsNullOrEmpty(block.ButtonUrl))
                    {
                        <a class="gb-btn" href="@block.ButtonUrl">@block.ButtonLabel</a>
                    }
                        <a class="gb-btn gb-btn-light" href="/Galerie">Voir la galerie</a>
                    </div>
                </div>
            </section>
            <div class="gb-hex-divider" aria-hidden="true"></div>
            break;

        case "Etapes":
            <section class="gb-section">
                <div class="gb-container">
                    <h2 class="gb-section-title">@block.Title</h2>
                    <ol class="gb-steps">
                        <li class="gb-step"><h3>La fleur</h3><p>Les abeilles butinent les floraisons de nos environs.</p></li>
                        <li class="gb-step"><h3>La ruche</h3><p>Le nectar devient miel, au rythme des saisons.</p></li>
                        <li class="gb-step"><h3>La récolte</h3><p>L'apiculteur récolte quand le miel est mûr.</p></li>
                        <li class="gb-step"><h3>Le pot</h3><p>Mise en pots et étiquetage, prêt pour votre table.</p></li>
                    </ol>
                </div>
            </section>
            break;

        case "ProduitsDeSaison":
            <section class="gb-section gb-section-alt">
                <div class="gb-container">
                    @{
                        var rangeUrl = string.IsNullOrEmpty(block.ButtonUrl) ? "/Produits" : block.ButtonUrl;
                        var rangeSlug = rangeUrl.Contains("gamme=") ? rangeUrl[(rangeUrl.IndexOf("gamme=") + 6)..] : null;
                    }
                    <h2 class="gb-section-title"><a href="@rangeUrl">@block.Title</a></h2>
                    <div class="gb-grid">
                        @foreach (var p in Model.Products.Where(x => rangeSlug == null || x.Category?.Slug == rangeSlug))
                        {
                            var minPrice = p.Variants.Where(v => v.IsActive).Select(v => v.Price).DefaultIfEmpty(0m).Min();
                            <article class="gb-card gb-card-product">
                                @if (p.MainMedia is { } img)
                                {
                                    <a class="gb-card-media" href="/Produits/@p.Slug" tabindex="-1" aria-hidden="true">
                                        <img src="@MediaUrls.Src(img, 480)" alt="" loading="lazy" width="480" height="480" />
                                    </a>
                                }
                                <h3 class="gb-card-title"><a href="/Produits/@p.Slug">@p.Name</a></h3>
                                <p class="gb-card-text">@p.ShortDescription</p>
                                <p class="gb-price">à partir de @minPrice.ToString("0.00") €</p>
                            </article>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(block.ButtonLabel))
                    {
                        <p class="gb-section-more"><a class="gb-btn gb-btn-secondary" href="@rangeUrl">@block.ButtonLabel</a></p>
                    }
                </div>
            </section>
            break;

        case "Calendrier":
            if (Model.CurrentMonth is { } c)
            {
                <section class="gb-section">
                    <div class="gb-container">
                        <h2 class="gb-section-title">@block.Title</h2>
                        <article class="gb-calendar-item gb-calendar-item-current">
                            <h3>@c.Title</h3>
                            <p><strong>Les abeilles :</strong> @c.WhatBeesDo</p>
                            <p><strong>L'apiculteur :</strong> @c.WhatBeekeeperDoes</p>
                            <p><a href="/Calendrier">Voir toute l'année</a></p>
                        </article>
                    </div>
                </section>
            }
            break;

        default:
            <section class="gb-section">
                <div class="gb-container gb-prose">
                    <h2>@block.Title</h2>
                    @Html.Raw(block.BodyHtml)
                </div>
            </section>
            break;
    }
}

@if (Model.GalleryTeaser.Count > 0)
{
    <section class="gb-section gb-teaser">
        <div class="gb-container">
            <h2 class="gb-section-title">Vie de la ruche</h2>
            <div class="gb-mosaic">
                @foreach (var m in Model.GalleryTeaser)
                {
                    <a class="gb-mosaic-item" href="/Galerie">
                        <img src="@MediaUrls.Src(m, 480)" srcset="@MediaUrls.SrcSet(m)" sizes="(min-width: 900px) 33vw, 50vw" alt="@MediaUrls.Alt(m)" loading="lazy" width="480" height="480" />
                    </a>
                }
            </div>
            <p class="gb-teaser-more"><a class="gb-btn gb-btn-secondary" href="/Galerie">Toute la galerie</a></p>
        </div>
    </section>
}
