@page "/Compte/Inscription"
@model GuysBee.Pages.Compte.InscriptionModel
@{
    ViewData["Title"] = "Créer mon compte";
}
<section class="gb-section">
    <div class="gb-container">
        <div class="gb-auth-card">
            <h1 class="gb-auth-title">Créer mon compte</h1>
            <p class="gb-auth-intro">Quelques secondes suffisent. Votre compte vous permet de retrouver vos adresses et de suivre vos commandes de miel.</p>
            <form method="post" class="gb-form gb-auth-form" novalidate>
                <div asp-validation-summary="All" class="gb-form-errors" role="alert"></div>
                <fieldset class="gb-auth-group">
                    <legend>Qui êtes-vous ?</legend>
                    <div class="gb-auth-row">
                        <div class="gb-field"><label asp-for="Input.FirstName">Prénom</label><input asp-for="Input.FirstName" class="gb-input" autocomplete="given-name" required /></div>
                        <div class="gb-field"><label asp-for="Input.LastName">Nom</label><input asp-for="Input.LastName" class="gb-input" autocomplete="family-name" required /></div>
                    </div>
                </fieldset>
                <fieldset class="gb-auth-group">
                    <legend>Vos identifiants</legend>
                    <div class="gb-field"><label asp-for="Input.Email">Adresse e-mail</label><input asp-for="Input.Email" type="email" class="gb-input" autocomplete="username" required /></div>
                    <div class="gb-auth-row">
                        <div class="gb-field"><label asp-for="Input.Password">Mot de passe</label><input asp-for="Input.Password" class="gb-input" autocomplete="new-password" required /></div>
                        <div class="gb-field"><label asp-for="Input.ConfirmPassword">Confirmer le mot de passe</label><input asp-for="Input.ConfirmPassword" class="gb-input" autocomplete="new-password" required /></div>
                    </div>
                </fieldset>
                <button type="submit" class="gb-btn gb-auth-submit">Créer mon compte</button>
            </form>
            <p class="gb-auth-alt">Déjà inscrit ? <a href="/Compte/Connexion">Me connecter</a></p>
        </div>
    </div>
</section>
